# =============================================================================
# Proli IA — configuración de proveedor (copia a .env y rellena tus keys)
# =============================================================================
#
# OPCIÓN A — OpenRouter (recomendado para probar varios modelos)
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-v1-...        → https://openrouter.ai/keys
#   AI_MODEL=google/gemini-2.0-flash-001
#
# OPCIÓN B — Gemini directo (Google AI Studio)
#   AI_PROVIDER=gemini
#   AI_API_KEY=AIza...               → https://aistudio.google.com/apikey
#   AI_MODEL=gemini-2.0-flash
#
# Auto-detecta por prefijo si omites AI_PROVIDER:
#   sk-or-... → OpenRouter    |    AIza... → Gemini
#
# Tras cambiar proveedor: npm run dev (reiniciar Vite)
# =============================================================================

# Modelo principal (si falla, Proli prueba otros gratis automáticamente):
#   openrouter/free              → router automático de modelos gratis (recomendado)
#   google/gemini-2.5-flash      → requiere créditos en OpenRouter
#   google/gemma-4-31b-it:free   → gratis, puede dejar de existir
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-tu-key-de-openrouter
AI_MODEL=openrouter/free

# Gemini directo — descomenta y comenta OpenRouter arriba:
# AI_PROVIDER=gemini
# AI_API_KEY=tu-key-de-google-ai-studio
# AI_MODEL=gemini-2.0-flash

# API Laravel (futuro)
VITE_API_URL=http://localhost:8000/api
